{
  "paths": {
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get list order dengan pagination dan filter",
        "operationId": "getOrders",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "outletId", "in": "query", "type": "string" },
          { "name": "status", "in": "query", "type": "string", "enum": ["PENDING", "COMPLETED", "VOID"] },
          { "name": "startDate", "in": "query", "type": "string", "format": "date-time" },
          { "name": "endDate", "in": "query", "type": "string", "format": "date-time" }
        ],
        "responses": {
          "200": {
            "description": "List order",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174030" },
                      "orderNumber": { "example": "ORD-20260901-001" },
                      "status": { "example": "PENDING" },
                      "totalAmount": { "example": 75000 },
                      "createdAt": { "example": "2026-09-01T10:00:00Z" }
                    }
                  }
                },
                "meta": { "example": { "page": 1, "limit": 20, "total": 5, "totalPages": 1 } }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Buat order baru",
        "operationId": "createOrder",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "orderType": { "type": "string", "enum": ["DINE_IN", "TAKE_AWAY"], "example": "DINE_IN" },
                "tableNumber": { "type": "string", "example": "A1" },
                "customerName": { "type": "string", "example": "Budi" },
                "notes": { "type": "string" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["variantId", "quantity"],
                    "properties": {
                      "variantId": { "type": "string", "example": "var-1" },
                      "quantity": { "type": "integer", "example": 2 },
                      "notes": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Order berhasil dibuat",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Order created successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174030",
                    "orderNumber": "ORD-20260901-001",
                    "status": "PENDING",
                    "totalAmount": 75000,
                    "items": [
                      { "variantId": "var-1", "productName": "Americano", "variantName": "Regular", "quantity": 2, "unitPrice": 25000, "subtotal": 50000 }
                    ]
                  }
                }
              }
            }
          },
          "400": { "description": "Variant not found atau validation error" },
          "403": { "description": "Tenant locked" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get detail order by ID",
        "operationId": "getOrderById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Detail order",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174030",
                    "orderNumber": "ORD-20260901-001",
                    "status": "PENDING",
                    "orderType": "DINE_IN",
                    "tableNumber": "A1",
                    "totalAmount": 75000,
                    "items": [
                      { "id": "item-1", "productName": "Americano", "variantName": "Regular", "quantity": 2, "unitPrice": 25000, "subtotal": 50000 }
                    ]
                  }
                }
              }
            }
          },
          "404": { "description": "Order not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Orders"],
        "summary": "Update order (sebelum dibayar)",
        "operationId": "updateOrder",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "tableNumber": { "type": "string", "example": "B2" },
                "customerName": { "type": "string", "example": "Budi Updated" },
                "notes": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order berhasil diupdate",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Order updated successfully" },
                "data": { "example": { "id": "123e4567-e89b-12d3-a456-426614174030", "tableNumber": "B2" } }
              }
            }
          },
          "404": { "description": "Order not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/orders/{id}/void": {
      "post": {
        "tags": ["Orders"],
        "summary": "Void order",
        "operationId": "voidOrder",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string", "example": "Customer membatalkan pesanan" },
                "reasonCategoryId": { "type": "string", "example": "reason-1" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order berhasil divoid",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Order voided successfully" },
                "data": {
                  "example": {
                    "order": { "id": "123e4567-e89b-12d3-a456-426614174030", "status": "VOID" },
                    "void": { "id": "void-1", "reason": "Customer membatalkan pesanan" }
                  }
                }
              }
            }
          },
          "400": { "description": "Order tidak bisa divoid" },
          "404": { "description": "Order not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/orders/{id}/print": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cetak struk / bill pesanan ke printer POS",
        "operationId": "printOrder",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Order UUID (harus berstatus COMPLETED)" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["printerType"],
              "properties": {
                "printerType": { "type": "string", "enum": ["RECEIPT", "KITCHEN", "BAR"], "example": "RECEIPT" },
                "printerId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174094" },
                "paperWidth": { "type": "string", "enum": ["58MM", "80MM"], "example": "80MM" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Print job berhasil diproses",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Bill print job processed successfully" },
                "data": {
                  "example": {
                    "mode": "NETWORK",
                    "printer": { "id": "123e4567-e89b-12d3-a456-426614174094", "name": "Kasir Utama Printer" },
                    "rawPayload": "Base64EscPosPayload=="
                  }
                }
              }
            }
          },
          "400": { "description": "Hanya order COMPLETED yang dapat dicetak atau printer belum diset" },
          "404": { "description": "Order not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
