{
  "paths": {
    "/printers": {
      "get": {
        "tags": ["Printers"],
        "summary": "Get list printer terkonfigurasi pada outlet",
        "operationId": "getPrinters",
        "produces": ["application/json"],
        "parameters": [
          { "name": "outletId", "in": "query", "type": "string", "description": "Filter by outlet UUID" },
          { "name": "type", "in": "query", "type": "string", "enum": ["RECEIPT", "KITCHEN", "BAR"], "description": "Filter by printer type" },
          { "name": "connectionType", "in": "query", "type": "string", "enum": ["BLUETOOTH", "NETWORK", "USB"], "description": "Filter by connection type" },
          { "name": "status", "in": "query", "type": "string", "enum": ["ACTIVE", "INACTIVE"], "description": "Filter by status" }
        ],
        "responses": {
          "200": {
            "description": "List printer",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printers retrieved successfully" },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174094" },
                      "name": { "example": "Kasir Utama Printer" },
                      "type": { "example": "RECEIPT" },
                      "connectionType": { "example": "NETWORK" },
                      "paperSize": { "example": "80mm" },
                      "ipAddress": { "example": "192.168.1.200" },
                      "port": { "example": 9100 },
                      "isDefault": { "example": true }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Printers"],
        "summary": "Tambah konfigurasi printer baru",
        "operationId": "createPrinter",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["outletId", "name", "type", "connectionType"],
              "properties": {
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "name": { "type": "string", "example": "Kasir Utama Printer" },
                "type": { "type": "string", "enum": ["RECEIPT", "KITCHEN", "BAR"], "example": "RECEIPT" },
                "connectionType": { "type": "string", "enum": ["BLUETOOTH", "NETWORK", "USB"], "example": "NETWORK" },
                "paperSize": { "type": "string", "enum": ["58mm", "80mm"], "default": "58mm", "example": "80mm" },
                "ipAddress": { "type": "string", "example": "192.168.1.200" },
                "port": { "type": "integer", "default": 9100, "example": 9100 },
                "bluetoothMac": { "type": "string", "example": "00:11:22:33:44:55" },
                "isDefault": { "type": "boolean", "default": false, "example": true }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Printer berhasil dikonfigurasi",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printer created successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174094",
                    "name": "Kasir Utama Printer",
                    "printerType": "RECEIPT",
                    "connectionType": "NETWORK",
                    "paperWidth": "80MM",
                    "ipAddress": "192.168.1.200",
                    "port": 9100,
                    "isDefault": true
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error atau outletId required" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/printers/{id}": {
      "get": {
        "tags": ["Printers"],
        "summary": "Get detail printer by ID",
        "operationId": "getPrinterById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Detail printer",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printer retrieved successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174094",
                    "name": "Kasir Utama Printer",
                    "printerType": "RECEIPT",
                    "connectionType": "NETWORK",
                    "paperWidth": "80MM",
                    "ipAddress": "192.168.1.200",
                    "port": 9100,
                    "isDefault": true
                  }
                }
              }
            }
          },
          "404": { "description": "Printer not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Printers"],
        "summary": "Update konfigurasi printer",
        "operationId": "updatePrinter",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "example": "Kasir 1 EPSON" },
                "type": { "type": "string", "enum": ["RECEIPT", "KITCHEN", "BAR"] },
                "connectionType": { "type": "string", "enum": ["BLUETOOTH", "NETWORK", "USB"] },
                "paperSize": { "type": "string", "enum": ["58mm", "80mm"] },
                "ipAddress": { "type": "string", "example": "192.168.1.201" },
                "port": { "type": "integer", "example": 9100 },
                "bluetoothMac": { "type": "string", "example": "00:11:22:33:44:55" },
                "isDefault": { "type": "boolean", "example": true },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "example": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Printer berhasil diupdate",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printer updated successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174094",
                    "name": "Kasir 1 EPSON"
                  }
                }
              }
            }
          },
          "404": { "description": "Printer not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Printers"],
        "summary": "Hapus konfigurasi printer",
        "operationId": "deletePrinter",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Printer berhasil dihapus",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printer deleted successfully" }
              }
            }
          },
          "404": { "description": "Printer not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/printers/routing-rules": {
      "get": {
        "tags": ["Printers"],
        "summary": "Get printer category routing rules for an outlet",
        "operationId": "getPrinterRoutingRules",
        "produces": ["application/json"],
        "parameters": [
          { "name": "outletId", "in": "query", "type": "string", "description": "Outlet UUID" }
        ],
        "responses": {
          "200": {
            "description": "Daftar pemetaan kategori produk ke printer station",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printer routing rules retrieved successfully" },
                "data": {
                  "type": "object",
                  "properties": {
                    "outletId": { "example": "123e4567-e89b-12d3-a456-426614174002" },
                    "printers": { "type": "array" },
                    "rules": { "type": "array" }
                  }
                }
              }
            }
          },
          "400": { "description": "outletId is required" },
          "404": { "description": "Outlet not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Printers"],
        "summary": "Update printer category routing rules for an outlet",
        "operationId": "updatePrinterRoutingRules",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["outletId", "routings"],
              "properties": {
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "routings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["categoryId", "printerId"],
                    "properties": {
                      "categoryId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174010" },
                      "printerId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174094" }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Routing rules berhasil diupdate",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Printer routing rules updated successfully" }
              }
            }
          },
          "400": { "description": "Invalid printer or category selection" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/printers/{id}/test-print": {
      "post": {
        "tags": ["Printers"],
        "summary": "Eksekusi tes cetak printer untuk verifikasi koneksi",
        "operationId": "testPrintPrinter",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Printer UUID" }
        ],
        "responses": {
          "200": {
            "description": "Tes cetak berhasil dieksekusi",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Test print executed successfully" },
                "data": {
                  "example": {
                    "printerId": "123e4567-e89b-12d3-a456-426614174094",
                    "name": "Kitchen Printer",
                    "type": "KITCHEN",
                    "connectionType": "BLUETOOTH",
                    "paperSize": "58mm",
                    "status": "READY_TO_PRINT",
                    "escposPayload": "Base64TestSlipBytes=="
                  }
                }
              }
            }
          },
          "404": { "description": "Printer not found" },
          "502": { "description": "Printer unreachable (network error)" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}

