{
  "paths": {
    "/purchases": {
      "get": {
        "tags": ["Purchases"],
        "summary": "Get paginated list of purchases",
        "operationId": "getPurchases",
        "produces": ["application/json"],
        "parameters": [
          { "name": "outletId", "in": "query", "type": "string", "description": "Filter by outlet UUID" },
          { "name": "supplierId", "in": "query", "type": "string", "description": "Filter by supplier UUID" },
          { "name": "status", "in": "query", "type": "string", "enum": ["DRAFT", "RECEIVED", "CANCELLED"], "description": "Filter by status" },
          { "name": "startDate", "in": "query", "type": "string", "description": "Filter start date (YYYY-MM-DD)" },
          { "name": "endDate", "in": "query", "type": "string", "description": "Filter end date (YYYY-MM-DD)" },
          { "name": "search", "in": "query", "type": "string", "description": "Search by purchase number or supplier name" },
          { "name": "page", "in": "query", "type": "integer", "default": 1, "description": "Page number" },
          { "name": "limit", "in": "query", "type": "integer", "default": 20, "description": "Items per page" }
        ],
        "responses": {
          "200": {
            "description": "List of purchases retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Purchases retrieved successfully" },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                      "purchaseNumber": { "example": "PB-2024-001" },
                      "purchaseDate": { "example": "2026-09-07T12:00:00.000Z" },
                      "status": { "example": "DRAFT" },
                      "totalItems": { "example": 2 },
                      "subtotal": { "example": 27000 },
                      "totalAmount": { "example": 27000 },
                      "notes": { "example": "Pesanan bahan baku mingguan" },
                      "outlet": { "type": "object" },
                      "supplier": { "type": "object" },
                      "items": { "type": "array", "items": { "type": "object" } }
                    }
                  }
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "page": { "example": 1 },
                    "limit": { "example": 20 },
                    "total": { "example": 1 },
                    "totalPages": { "example": 1 }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Purchases"],
        "summary": "Create a new purchase (DRAFT status)",
        "operationId": "createPurchase",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["outletId", "supplierId", "items"],
              "properties": {
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "supplierId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174003" },
                "purchaseNumber": { "type": "string", "example": "PB-2024-001" },
                "purchaseDate": { "type": "string", "example": "2026-09-07T00:00:00.000Z" },
                "notes": { "type": "string", "example": "Pembelian susu dan cup" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["inventoryItemId", "quantityOrdered", "unitCost"],
                    "properties": {
                      "inventoryItemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174050" },
                      "quantityOrdered": { "type": "number", "example": 1000 },
                      "unitCost": { "type": "number", "example": 13 }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Purchase created successfully as DRAFT",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Purchase created successfully as DRAFT" },
                "data": { "type": "object" }
              }
            }
          },
          "400": { "description": "Validation error or invalid foreign key" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/purchases/{id}": {
      "get": {
        "tags": ["Purchases"],
        "summary": "Get purchase detail by ID",
        "operationId": "getPurchaseById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Purchase UUID" }
        ],
        "responses": {
          "200": {
            "description": "Purchase detail retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Purchase retrieved successfully" },
                "data": { "type": "object" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Purchase not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Purchases"],
        "summary": "Update purchase (only when status is DRAFT)",
        "operationId": "updatePurchase",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Purchase UUID" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "supplierId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174003" },
                "notes": { "type": "string", "example": "Update catatan" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "inventoryItemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174050" },
                      "quantityOrdered": { "type": "number", "example": 2000 },
                      "unitCost": { "type": "number", "example": 13.5 }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Purchase updated successfully" },
                "data": { "type": "object" }
              }
            }
          },
          "400": { "description": "Validation error or purchase is not DRAFT" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Purchase not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Purchases"],
        "summary": "Cancel / Delete purchase (only when status is DRAFT)",
        "operationId": "deletePurchase",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Purchase UUID" }
        ],
        "responses": {
          "200": {
            "description": "Purchase deleted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Purchase deleted successfully" }
              }
            }
          },
          "400": { "description": "Purchase is not DRAFT" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Purchase not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/purchases/{id}/receive": {
      "post": {
        "tags": ["Purchases"],
        "summary": "Receive purchase goods: increment physical stock, log movement, and update cumulative unit cost",
        "operationId": "receivePurchase",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Purchase UUID" },
          {
            "in": "body",
            "name": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "notes": { "type": "string", "example": "Barang telah diterima lengkap dan dicek fisik" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["itemId", "quantityReceived"],
                    "properties": {
                      "itemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174099" },
                      "quantityReceived": { "type": "number", "example": 1000 }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase goods received, stock incremented, and unit cost updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Purchase goods received, stock incremented, and unit cost updated successfully" },
                "data": { "type": "object" }
              }
            }
          },
          "400": { "description": "Purchase is not in DRAFT status" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Purchase not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}

