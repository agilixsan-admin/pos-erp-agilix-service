{
  "paths": {
    "/payments": {
      "get": {
        "tags": ["Payments"],
        "summary": "Get list payment dengan pagination",
        "operationId": "getPayments",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "outletId", "in": "query", "type": "string" },
          { "name": "paymentMethod", "in": "query", "type": "string", "enum": ["CASH", "QRIS"] },
          { "name": "startDate", "in": "query", "type": "string", "format": "date-time" },
          { "name": "endDate", "in": "query", "type": "string", "format": "date-time" }
        ],
        "responses": {
          "200": {
            "description": "List payment",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174040" },
                      "orderId": { "example": "123e4567-e89b-12d3-a456-426614174030" },
                      "paymentMethod": { "example": "CASH" },
                      "amount": { "example": 80000 },
                      "changeAmount": { "example": 5000 },
                      "status": { "example": "SUCCESS" },
                      "paidAt": { "example": "2026-09-01T10:30:00Z" }
                    }
                  }
                },
                "meta": { "example": { "page": 1, "limit": 20, "total": 10, "totalPages": 1 } }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Payments"],
        "summary": "Proses pembayaran untuk order",
        "operationId": "createPayment",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["orderId", "paymentMethod", "amount"],
              "properties": {
                "orderId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174030" },
                "paymentMethod": { "type": "string", "enum": ["CASH", "QRIS"], "example": "CASH" },
                "amount": { "type": "number", "example": 80000, "description": "Jumlah uang yang diterima" },
                "referenceNumber": { "type": "string", "example": "QRIS-REF-001", "description": "Nomor referensi QRIS (opsional)" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pembayaran berhasil",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Payment processed successfully" },
                "data": {
                  "example": {
                    "payment": {
                      "id": "123e4567-e89b-12d3-a456-426614174040",
                      "paymentMethod": "CASH",
                      "amount": 80000,
                      "changeAmount": 5000,
                      "status": "SUCCESS"
                    },
                    "transaction": {
                      "id": "123e4567-e89b-12d3-a456-426614174050",
                      "transactionNumber": "TRX-20260901-001",
                      "amount": 75000,
                      "status": "COMPLETED"
                    },
                    "order": {
                      "id": "123e4567-e89b-12d3-a456-426614174030",
                      "status": "COMPLETED"
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Amount kurang atau order sudah dibayar (duplicate protection)" },
          "403": { "description": "Tenant locked" },
          "404": { "description": "Order not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/payments/qris/generate": {
      "post": {
        "tags": ["Payments"],
        "summary": "Generate QRIS dinamis untuk order",
        "operationId": "generateQris",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["orderId"],
              "properties": {
                "orderId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174030" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Dynamic QRIS berhasil di-generate",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Dynamic QRIS generated successfully" },
                "data": {
                  "example": {
                    "paymentId": "123e4567-e89b-12d3-a456-426614174041",
                    "orderId": "123e4567-e89b-12d3-a456-426614174030",
                    "amount": 75000,
                    "qrString": "00020101021226590014ID.LINKAJA.WWW01189360091100000000005204581253033605405750005802ID5911AGILIX CAFE6007JAKARTA6304ABCD",
                    "qrUrl": "https://api.midtrans.com/v2/qris/123/qr-code",
                    "expiresAt": "2026-09-01T10:45:00Z",
                    "status": "PENDING"
                  }
                }
              }
            }
          },
          "400": { "description": "Order sudah lunas atau metode QRIS dinonaktifkan" },
          "404": { "description": "Order not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/payments/qris/status/{orderId}": {
      "get": {
        "tags": ["Payments"],
        "summary": "Polling status pembayaran QRIS",
        "operationId": "getQrisStatus",
        "produces": ["application/json"],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Status QRIS",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "QRIS status retrieved successfully" },
                "data": {
                  "example": {
                    "orderId": "123e4567-e89b-12d3-a456-426614174030",
                    "paymentId": "123e4567-e89b-12d3-a456-426614174041",
                    "status": "PAID",
                    "paidAt": "2026-09-01T10:32:00Z"
                  }
                }
              }
            }
          },
          "404": { "description": "QRIS payment not found for this order" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/payments/qris/check/{orderId}": {
      "post": {
        "tags": ["Payments"],
        "summary": "Kasir melakukan pengecekan langsung / inquiry status ke gateway",
        "operationId": "checkQrisStatus",
        "produces": ["application/json"],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Hasil inquiry gateway",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "QRIS status checked successfully" },
                "data": {
                  "example": {
                    "orderId": "123e4567-e89b-12d3-a456-426614174030",
                    "status": "PAID"
                  }
                }
              }
            }
          },
          "404": { "description": "Order or payment not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/payments/qris/simulate-pay/{paymentId}": {
      "post": {
        "tags": ["Payments"],
        "summary": "Simulasi settlement pembayaran QRIS (sandbox testing)",
        "operationId": "simulateQrisPayment",
        "produces": ["application/json"],
        "parameters": [
          { "name": "paymentId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Simulasi berhasil, payment dan order menjadi COMPLETED",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Simulated QRIS payment settled successfully" },
                "data": {
                  "example": {
                    "paymentId": "123e4567-e89b-12d3-a456-426614174041",
                    "status": "PAID"
                  }
                }
              }
            }
          },
          "400": { "description": "Payment bukan QRIS atau sudah lunas" },
          "404": { "description": "Payment not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
