{
  "paths": {
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Get list user dalam tenant",
        "operationId": "getUsers",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "search", "in": "query", "type": "string" },
          { "name": "outletId", "in": "query", "type": "string" },
          { "name": "status", "in": "query", "type": "string", "enum": ["ACTIVE", "INACTIVE"] }
        ],
        "responses": {
          "200": {
            "description": "List user",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174060" },
                      "name": { "example": "Ahmad Mubarok" },
                      "email": { "example": "mubarok@testcafe.com" },
                      "outletId": { "example": "outlet-1" },
                      "role": { "example": { "id": "role-1", "name": "CASHIER" } },
                      "status": { "example": "ACTIVE" }
                    }
                  }
                },
                "meta": { "example": { "page": 1, "limit": 20, "total": 5, "totalPages": 1 } }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Users"],
        "summary": "Buat user baru",
        "operationId": "createUser",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "email", "password", "roleId", "outletId"],
              "properties": {
                "name": { "type": "string", "example": "Siti Rahayu" },
                "email": { "type": "string", "example": "siti@testcafe.com" },
                "password": { "type": "string", "example": "Password123!" },
                "roleId": { "type": "string", "example": "role-cashier" },
                "outletId": { "type": "string", "example": "outlet-1" },
                "phone": { "type": "string", "example": "+628123456792" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User berhasil dibuat",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "User created successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174060",
                    "name": "Siti Rahayu",
                    "email": "siti@testcafe.com",
                    "status": "ACTIVE"
                  }
                }
              }
            }
          },
          "409": { "description": "Email sudah digunakan" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get detail user by ID",
        "operationId": "getUserById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Detail user",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174060",
                    "name": "Ahmad Mubarok",
                    "email": "mubarok@testcafe.com",
                    "phone": "+628123456789",
                    "outletId": "outlet-1",
                    "role": { "id": "role-1", "name": "CASHIER" },
                    "status": "ACTIVE",
                    "createdAt": "2026-09-01T10:00:00Z"
                  }
                }
              }
            }
          },
          "404": { "description": "User not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update user",
        "operationId": "updateUser",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "example": "Ahmad Mubarok Updated" },
                "phone": { "type": "string", "example": "+628123456793" },
                "roleId": { "type": "string", "example": "role-manager" },
                "outletId": { "type": "string", "example": "outlet-2" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User berhasil diupdate",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "User updated successfully" },
                "data": { "example": { "id": "123e4567-e89b-12d3-a456-426614174060", "name": "Ahmad Mubarok Updated" } }
              }
            }
          },
          "404": { "description": "User not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Hapus user (soft delete / deactivate)",
        "operationId": "deleteUser",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "User berhasil dihapus",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "User deleted successfully" },
                "data": { "example": null }
              }
            }
          },
          "404": { "description": "User not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
