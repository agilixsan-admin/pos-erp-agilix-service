{
  "paths": {
    "/packagings/categories": {
      "get": {
        "tags": ["Packaging"],
        "summary": "Get list kategori packaging",
        "operationId": "getPackagingCategories",
        "produces": ["application/json"],
        "parameters": [
          { "name": "search", "in": "query", "type": "string" },
          { "name": "status", "in": "query", "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": {
            "description": "List of packaging categories",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                      "name": { "example": "Cup" },
                      "description": { "example": "Gelas dan cangkir" },
                      "status": { "example": "ACTIVE" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Packaging"],
        "summary": "Buat kategori packaging baru",
        "operationId": "createPackagingCategory",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Cup" },
                "description": { "type": "string", "example": "Gelas dan cangkir" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "default": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Packaging category created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Packaging category created successfully" }
              }
            }
          }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/packagings/categories/{id}": {
      "get": {
        "tags": ["Packaging"],
        "summary": "Get detail kategori packaging by ID",
        "operationId": "getPackagingCategoryById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Detail kategori packaging" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Packaging"],
        "summary": "Update kategori packaging",
        "operationId": "updatePackagingCategory",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Cup & Containers" },
                "description": { "type": "string", "example": "Gelas, cangkir dan wadah" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Kategori packaging berhasil diupdate" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Packaging"],
        "summary": "Hapus kategori packaging",
        "operationId": "deletePackagingCategory",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Kategori packaging berhasil dihapus" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/packagings": {
      "get": {
        "tags": ["Packaging"],
        "summary": "Get paginated list of packaging configurations",
        "operationId": "getPackagings",
        "produces": ["application/json"],
        "parameters": [
          { "name": "outletId", "in": "query", "type": "string", "description": "Filter by outlet UUID" },
          { "name": "categoryId", "in": "query", "type": "string", "description": "Filter by packaging category UUID" },
          { "name": "status", "in": "query", "type": "string", "enum": ["ACTIVE", "INACTIVE"], "description": "Filter by status" },
          { "name": "search", "in": "query", "type": "string", "description": "Search by packaging name or SKU" },
          { "name": "page", "in": "query", "type": "integer", "default": 1, "description": "Page number" },
          { "name": "limit", "in": "query", "type": "integer", "default": 20, "description": "Items per page" }
        ],
        "responses": {
          "200": {
            "description": "List of packagings retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                      "name": { "example": "Cup 16 oz" },
                      "sku": { "example": "PKG-CUP-16" },
                      "categoryId": { "example": "123e4567-e89b-12d3-a456-426614174001" },
                      "description": { "example": "Paper cup untuk minuman dingin" },
                      "status": { "example": "ACTIVE" },
                      "outletId": { "example": "123e4567-e89b-12d3-a456-426614174002" },
                      "inventoryItemId": { "example": "123e4567-e89b-12d3-a456-426614174050" }
                    }
                  }
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "page": { "example": 1 },
                    "limit": { "example": 20 },
                    "total": { "example": 1 },
                    "totalPages": { "example": 1 }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Packaging"],
        "summary": "Create a new packaging configuration",
        "operationId": "createPackaging",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Cup 16 oz" },
                "sku": { "type": "string", "example": "PKG-CUP-16" },
                "categoryId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174001" },
                "description": { "type": "string", "example": "Paper cup untuk minuman dingin" },
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "inventoryItemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174050" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "example": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Packaging created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "object",
                  "properties": {
                    "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                    "name": { "example": "Cup 16 oz" },
                    "sku": { "example": "PKG-CUP-16" },
                    "categoryId": { "example": "123e4567-e89b-12d3-a456-426614174001" },
                    "description": { "example": "Paper cup untuk minuman dingin" },
                    "status": { "example": "ACTIVE" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error or invalid foreign key" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/packagings/{id}": {
      "get": {
        "tags": ["Packaging"],
        "summary": "Get packaging configuration detail by ID",
        "operationId": "getPackagingById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Packaging UUID" }
        ],
        "responses": {
          "200": {
            "description": "Packaging detail retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "object",
                  "properties": {
                    "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                    "name": { "example": "Paper Bag Medium" },
                    "sku": { "example": "PKG-BAG-01" },
                    "status": { "example": "ACTIVE" },
                    "outlet": { "type": "object" },
                    "category": { "type": "object" },
                    "inventoryItem": { "type": "object" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Packaging not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Packaging"],
        "summary": "Update packaging configuration",
        "operationId": "updatePackaging",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Packaging UUID" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "example": "Paper Bag Large" },
                "sku": { "type": "string", "example": "PKG-BAG-02" },
                "categoryId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174001" },
                "description": { "type": "string", "example": "Paper bag ukuran besar" },
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "inventoryItemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174050" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "example": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Packaging updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "object",
                  "properties": {
                    "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                    "name": { "example": "Paper Bag Large" },
                    "sku": { "example": "PKG-BAG-02" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Packaging not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Packaging"],
        "summary": "Soft delete packaging configuration",
        "operationId": "deletePackaging",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Packaging UUID" }
        ],
        "responses": {
          "200": {
            "description": "Packaging deleted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Packaging deleted successfully" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Packaging not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}

