{
  "paths": {
    "/inventory": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get list inventory items dengan stock",
        "operationId": "getInventory",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "search", "in": "query", "type": "string" },
          { "name": "itemType", "in": "query", "type": "string", "enum": ["ALL", "RAW_MATERIAL", "PACKAGING"] },
          { "name": "stockStatus", "in": "query", "type": "string", "enum": ["ALL", "NORMAL", "LOW_STOCK", "OUT_OF_STOCK"] },
          { "name": "categoryId", "in": "query", "type": "string" },
          { "name": "outletId", "in": "query", "type": "string" },
          { "name": "sortBy", "in": "query", "type": "string", "enum": ["name", "createdAt", "updatedAt", "sku", "unitCost"] },
          { "name": "sortOrder", "in": "query", "type": "string", "enum": ["ASC", "DESC"] }
        ],
        "responses": {
          "200": {
            "description": "List inventory items with stock summary and metrics",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174020" },
                      "name": { "example": "Susu Full Cream" },
                      "itemType": { "example": "RAW_MATERIAL" },
                      "sku": { "example": "RM-001" },
                      "unit": { "example": "ml" },
                      "unitCost": { "example": 12 },
                      "minimumStock": { "example": 5000 },
                      "currentStock": { "example": 9500 },
                      "stockValue": { "example": 114000 },
                      "stockStatus": { "example": "NORMAL" },
                      "status": { "example": "ACTIVE" },
                      "stocks": {
                        "type": "array",
                        "example": [
                          { "outletId": "outlet-1", "quantity": 9500 }
                        ]
                      }
                    }
                  }
                },
                "meta": { "example": { "page": 1, "limit": 20, "total": 128, "totalPages": 7 } },
                "summary": {
                  "example": {
                    "totalItems": 128,
                    "totalInventoryValue": 24850000,
                    "lowStockCount": 12,
                    "outOfStockCount": 3
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/categories": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get list kategori bahan baku",
        "operationId": "getInventoryCategories",
        "produces": ["application/json"],
        "parameters": [
          { "name": "search", "in": "query", "type": "string" },
          { "name": "status", "in": "query", "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": {
            "description": "List kategori bahan baku",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174099" },
                      "name": { "example": "Dairy" },
                      "description": { "example": "Susu dan olahan susu" },
                      "status": { "example": "ACTIVE" }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Inventory"],
        "summary": "Buat kategori bahan baku baru",
        "operationId": "createInventoryCategory",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Dairy" },
                "description": { "type": "string", "example": "Susu dan olahan susu" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "default": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Kategori bahan baku berhasil dibuat",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Inventory category created successfully" }
              }
            }
          }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/categories/{id}": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get detail kategori bahan baku by ID",
        "operationId": "getInventoryCategoryById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Detail kategori bahan baku" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Inventory"],
        "summary": "Update kategori bahan baku",
        "operationId": "updateInventoryCategory",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Dairy & Milk" },
                "description": { "type": "string", "example": "Susu dan turunannya" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Kategori bahan baku berhasil diupdate" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Inventory"],
        "summary": "Hapus kategori bahan baku",
        "operationId": "deleteInventoryCategory",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Kategori bahan baku berhasil dihapus" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/items": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Buat item bahan baku / inventory baru",
        "operationId": "createInventoryItem",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Fresh Milk" },
                "sku": { "type": "string", "example": "ING-MILK-01" },
                "categoryId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174099" },
                "description": { "type": "string", "example": "Susu segar pasteurisasi" },
                "unit": { "type": "string", "example": "ml", "default": "pcs" },
                "minimumStock": { "type": "number", "example": 1000, "default": 0 },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "default": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Item berhasil dibuat",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Inventory item created successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174021",
                    "name": "Fresh Milk",
                    "unit": "ml",
                    "minimumStock": 1000
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/items/{id}": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get detail inventory item by ID",
        "operationId": "getInventoryItem",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Detail inventory item",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Inventory item retrieved successfully" },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174020",
                    "name": "Coffee Beans",
                    "unit": "gram",
                    "minimumStock": 500,
                    "stocks": [
                      { "outletId": "outlet-1", "quantity": 4500 }
                    ]
                  }
                }
              }
            }
          },
          "404": { "description": "Inventory item not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "put": {
        "tags": ["Inventory"],
        "summary": "Update item inventory",
        "operationId": "updateInventoryItem",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "unit", "minimumStock", "status"],
              "properties": {
                "name": { "type": "string", "example": "Premium Arabica Beans" },
                "sku": { "type": "string", "example": "ING-ESP-01" },
                "unit": { "type": "string", "example": "gram" },
                "minimumStock": { "type": "number", "example": 800 },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "example": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item berhasil diupdate",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Inventory item updated successfully" }
              }
            }
          },
          "404": { "description": "Inventory item not found" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Inventory"],
        "summary": "Hapus item inventory",
        "operationId": "deleteInventoryItem",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Item berhasil dihapus",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Inventory item deleted successfully" }
              }
            }
          },
          "404": { "description": "Inventory item not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/items/{id}/stocks": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Inisialisasi / set stok awal item pada outlet",
        "operationId": "setInventoryStock",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["outletId", "quantity"],
              "properties": {
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "quantity": { "type": "number", "example": 5000 }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stok berhasil diset",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Inventory stock updated successfully" }
              }
            }
          },
          "404": { "description": "Item atau outlet not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/movements": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get list history pergerakan stok",
        "operationId": "getInventoryMovements",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "outletId", "in": "query", "type": "string" },
          { "name": "itemId", "in": "query", "type": "string" },
          { "name": "movementType", "in": "query", "type": "string", "enum": ["IN", "OUT", "SALE", "ADJUSTMENT", "VOID"] }
        ],
        "responses": {
          "200": {
            "description": "List pergerakan stok",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": { "type": "array", "items": { "type": "object" } }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/adjustments": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get paginated list of stock adjustments dengan summary cards",
        "operationId": "getStockAdjustments",
        "produces": ["application/json"],
        "parameters": [
          { "name": "outletId", "in": "query", "type": "string", "description": "Filter by outlet UUID" },
          { "name": "inventoryItemId", "in": "query", "type": "string", "description": "Filter by item UUID" },
          { "name": "reasonCategoryId", "in": "query", "type": "string", "description": "Filter by reason category UUID" },
          { "name": "type", "in": "query", "type": "string", "enum": ["IN", "OUT"], "description": "Filter by adjustment type" },
          { "name": "startDate", "in": "query", "type": "string", "description": "Filter start date (YYYY-MM-DD)" },
          { "name": "endDate", "in": "query", "type": "string", "description": "Filter end date (YYYY-MM-DD)" },
          { "name": "search", "in": "query", "type": "string", "description": "Search by adjustment no, item name, reason, or notes" },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": {
            "description": "List of stock adjustments retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Stock adjustments retrieved successfully" },
                "data": {
                  "type": "array",
                  "items": { "type": "object" }
                },
                "meta": { "type": "object" },
                "summary": {
                  "type": "object",
                  "properties": {
                    "totalAdjustments": { "example": 48 },
                    "totalIn": { "example": 12 },
                    "totalOut": { "example": 36 },
                    "totalLossValue": { "example": 150000 }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Inventory"],
        "summary": "Buat stock adjustment (penyesuaian stok masuk / keluar dengan bukti foto)",
        "operationId": "createAdjustment",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["type", "itemId", "quantity"],
              "properties": {
                "type": { "type": "string", "enum": ["IN", "OUT"], "example": "OUT" },
                "itemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174020" },
                "inventoryItemId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174020" },
                "quantity": { "type": "number", "example": 900 },
                "outletId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                "reasonCategoryId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174099" },
                "notes": { "type": "string", "example": "Kemasan bocor dan tidak layak pakai" },
                "imageUrl": { "type": "string", "example": "https://storage.example.com/uploads/proof.webp" },
                "adjustmentDate": { "type": "string", "format": "date-time", "example": "2026-09-07T10:00:00.000Z" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Adjustment berhasil",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Stock adjustment completed successfully" },
                "data": { "type": "object" }
              }
            }
          },
          "400": { "description": "Insufficient stock atau validation error" },
          "403": { "description": "Permission denied atau tenant locked" },
          "404": { "description": "Item atau outlet not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/adjustments/{id}": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get detail stock adjustment by ID",
        "operationId": "getAdjustmentById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Adjustment UUID" }
        ],
        "responses": {
          "200": {
            "description": "Stock adjustment detail retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Stock adjustment retrieved successfully" },
                "data": { "type": "object" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Stock adjustment not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/adjustments/upload-proof": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Upload foto bukti fisik stock adjustment",
        "operationId": "uploadAdjustmentProof",
        "consumes": ["multipart/form-data"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "description": "Gambar bukti fisik (JPG, PNG, WebP max 5MB)",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "201": {
            "description": "Adjustment proof image uploaded successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Adjustment proof image uploaded successfully" },
                "data": {
                  "type": "object",
                  "properties": {
                    "imageUrl": { "example": "https://storage.example.com/uploads/tenant-1/adjustments/proof_123.webp" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid file format or size" },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/reason-categories": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get list kategori alasan adjustment stok",
        "operationId": "getReasonCategories",
        "produces": ["application/json"],
        "parameters": [
          { "name": "type", "in": "query", "type": "string", "enum": ["IN", "OUT"] }
        ],
        "responses": {
          "200": {
            "description": "List reason categories",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        },
        "security": [{ "Bearer": [] }]
      },
      "post": {
        "tags": ["Inventory"],
        "summary": "Buat kategori alasan adjustment baru",
        "operationId": "createReasonCategory",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "example": "Barang Rusak / Basi" },
                "type": { "type": "string", "enum": ["IN", "OUT", "BOTH"], "default": "BOTH", "example": "OUT" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "default": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Reason category created" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/inventory/reason-categories/{id}": {
      "put": {
        "tags": ["Inventory"],
        "summary": "Update kategori alasan adjustment",
        "operationId": "updateReasonCategory",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "type", "status"],
              "properties": {
                "name": { "type": "string", "example": "Barang Kadaluarsa" },
                "type": { "type": "string", "enum": ["IN", "OUT", "BOTH"], "example": "OUT" },
                "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "example": "ACTIVE" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Reason category updated" }
        },
        "security": [{ "Bearer": [] }]
      },
      "delete": {
        "tags": ["Inventory"],
        "summary": "Hapus kategori alasan adjustment",
        "operationId": "deleteReasonCategory",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Reason category deleted" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
