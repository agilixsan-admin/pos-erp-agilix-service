{
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user dan dapatkan JWT token",
        "operationId": "authLogin",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email", "password"],
              "properties": {
                "email": { "type": "string", "example": "owner@testcafe.com" },
                "password": { "type": "string", "example": "Password123!" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login berhasil",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Login successful" },
                "data": {
                  "example": {
                    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" },
          "429": { "description": "Too many requests" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get profil user yang sedang login",
        "operationId": "authMe",
        "produces": ["application/json"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Profil user",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174000",
                    "email": "owner@testcafe.com",
                    "name": "Ahmad Mubarok",
                    "tenantId": "123e4567-e89b-12d3-a456-426614174001",
                    "outletId": "123e4567-e89b-12d3-a456-426614174002",
                    "role": {
                      "id": "123e4567-e89b-12d3-a456-426614174003",
                      "name": "OWNER",
                      "menuAccess": ["product.read", "order.create"]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
