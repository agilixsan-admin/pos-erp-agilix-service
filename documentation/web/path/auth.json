{
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user dan dapatkan JWT tokens beserta profil user",
        "operationId": "authLogin",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email", "password"],
              "properties": {
                "email": { "type": "string", "example": "owner@testcafe.com" },
                "password": { "type": "string", "example": "Password123!" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login berhasil",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": true },
                "message": { "type": "string", "example": "Login successful" },
                "data": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "tokenType": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expiresIn": {
                      "type": "number",
                      "description": "Masa aktif access token dalam detik",
                      "example": 1800
                    },
                    "refreshToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "refreshExpiresIn": {
                      "type": "number",
                      "description": "Masa aktif refresh token dalam detik",
                      "example": 604800
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174000" },
                        "name": { "type": "string", "example": "Ahmad Mubarok" },
                        "email": { "type": "string", "example": "owner@testcafe.com" },
                        "tenantId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174001" },
                        "outletId": { "type": "string", "nullable": true, "example": "123e4567-e89b-12d3-a456-426614174002" },
                        "isSuperAdmin": { "type": "boolean", "example": false },
                        "status": { "type": "string", "example": "ACTIVE" },
                        "role": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174003" },
                            "name": { "type": "string", "example": "OWNER" },
                            "permissions": { "type": "array", "items": { "type": "string" }, "example": ["product.read", "order.create"] }
                          }
                        },
                        "outlet": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174002" },
                            "name": { "type": "string", "example": "Outlet Pusat" }
                          }
                        },
                        "tenant": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174001" },
                            "name": { "type": "string", "example": "Test Cafe" },
                            "status": { "type": "string", "example": "ACTIVE" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" },
          "429": { "description": "Too many requests" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token menggunakan refresh token",
        "operationId": "authRefresh",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["refreshToken"],
              "properties": {
                "refreshToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token berhasil di-refresh",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": true },
                "message": { "type": "string", "example": "Token refreshed successfully" },
                "data": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
                    "tokenType": { "type": "string", "example": "Bearer" },
                    "expiresIn": { "type": "number", "example": 1800 },
                    "refreshToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
                    "refreshExpiresIn": { "type": "number", "example": 604800 },
                    "user": { "type": "object" }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid or expired refresh token" },
          "429": { "description": "Too many requests" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get profil user yang sedang login",
        "operationId": "authMe",
        "produces": ["application/json"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Profil user",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174000",
                    "email": "owner@testcafe.com",
                    "name": "Ahmad Mubarok",
                    "tenantId": "123e4567-e89b-12d3-a456-426614174001",
                    "outletId": "123e4567-e89b-12d3-a456-426614174002",
                    "role": {
                      "id": "123e4567-e89b-12d3-a456-426614174003",
                      "name": "OWNER",
                      "permissions": ["product.read", "order.create"]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
