{
  "paths": {
    "/audit-logs": {
      "get": {
        "tags": ["Audit Logs"],
        "summary": "Get audit logs dengan pagination dan filter",
        "operationId": "getAuditLogs",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "action", "in": "query", "type": "string", "example": "USER_LOGIN", "description": "Filter by action name" },
          { "name": "actorType", "in": "query", "type": "string", "enum": ["USER", "SYSTEM"], "description": "Filter by actor type" },
          { "name": "actorId", "in": "query", "type": "string", "description": "Filter by actor UUID" },
          { "name": "startDate", "in": "query", "type": "string", "format": "date-time" },
          { "name": "endDate", "in": "query", "type": "string", "format": "date-time" }
        ],
        "responses": {
          "200": {
            "description": "List audit logs",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174090" },
                      "action": { "example": "USER_LOGIN" },
                      "actorType": { "example": "USER" },
                      "actorId": { "example": "123e4567-e89b-12d3-a456-426614174060" },
                      "metadata": {
                        "example": { "email": "mubarok@testcafe.com", "outletId": "outlet-1" }
                      },
                      "createdAt": { "example": "2026-09-01T10:00:00Z" }
                    }
                  }
                },
                "meta": { "example": { "page": 1, "limit": 20, "total": 250, "totalPages": 13 } }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Permission denied" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
