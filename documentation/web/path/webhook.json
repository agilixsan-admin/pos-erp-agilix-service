{
  "paths": {
    "/webhooks/console": {
      "post": {
        "tags": ["Webhook"],
        "summary": "Terima event dari Agilix Console",
        "operationId": "webhookConsole",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Console API Key"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["event", "eventId", "timestamp", "data"],
              "properties": {
                "event": {
                  "type": "string",
                  "enum": ["tenant.created", "tenant.locked", "tenant.unlocked", "tenant.updated", "tenant.subscription.updated", "tenant.subscription.expired"],
                  "example": "tenant.locked"
                },
                "eventId": {
                  "type": "string",
                  "example": "evt-123e4567-e89b-12d3-a456-426614174000"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-09-01T10:00:00.000Z"
                },
                "data": {
                  "type": "object",
                  "example": {
                    "tenantId": "123e4567-e89b-12d3-a456-426614174001",
                    "reason": "subscription_expired"
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event berhasil diproses",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Event processed successfully" }
              }
            }
          },
          "400": { "description": "Invalid payload atau unknown event" },
          "401": { "description": "Invalid or missing API Key" },
          "409": { "description": "Duplicate event (sudah diproses)" },
          "500": { "description": "Internal server error (retryable)" }
        }
      }
    },
    "/webhooks/payment": {
      "post": {
        "tags": ["Webhook"],
        "summary": "Webhook callback dari Payment Gateway (Midtrans/Mock QRIS)",
        "operationId": "webhookPayment",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "order_id": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174030" },
                "transaction_status": { "type": "string", "example": "settlement" },
                "fraud_status": { "type": "string", "example": "accept" },
                "status_code": { "type": "string", "example": "200" },
                "gross_amount": { "type": "string", "example": "75000.00" },
                "signature_key": { "type": "string", "example": "sha512signature..." }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Callback webhook berhasil diverifikasi dan order diselesaikan",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "message": { "example": "Payment webhook processed successfully" }
              }
            }
          },
          "400": { "description": "Invalid payload atau signature verification failed" }
        }
      }
    }
  }
}
