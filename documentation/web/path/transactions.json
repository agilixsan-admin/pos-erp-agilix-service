{
  "paths": {
    "/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get list transaksi dengan pagination",
        "operationId": "getTransactions",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 },
          { "name": "outletId", "in": "query", "type": "string" },
          { "name": "startDate", "in": "query", "type": "string", "format": "date-time" },
          { "name": "endDate", "in": "query", "type": "string", "format": "date-time" }
        ],
        "responses": {
          "200": {
            "description": "List transaksi",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "example": "123e4567-e89b-12d3-a456-426614174050" },
                      "transactionNumber": { "example": "TRX-20260901-001" },
                      "amount": { "example": 75000 },
                      "status": { "example": "COMPLETED" },
                      "completedAt": { "example": "2026-09-01T10:30:00Z" }
                    }
                  }
                },
                "meta": { "example": { "page": 1, "limit": 20, "total": 10, "totalPages": 1 } }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "Bearer": [] }]
      }
    },
    "/transactions/{id}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get detail transaksi by ID",
        "operationId": "getTransactionById",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Detail transaksi",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "example": true },
                "data": {
                  "example": {
                    "id": "123e4567-e89b-12d3-a456-426614174050",
                    "transactionNumber": "TRX-20260901-001",
                    "amount": 75000,
                    "status": "COMPLETED",
                    "completedAt": "2026-09-01T10:30:00Z",
                    "order": {
                      "id": "123e4567-e89b-12d3-a456-426614174030",
                      "orderNumber": "ORD-20260901-001",
                      "items": [
                        { "productName": "Americano", "variantName": "Regular", "quantity": 2, "subtotal": 50000 }
                      ]
                    },
                    "payment": {
                      "paymentMethod": "CASH",
                      "amount": 80000,
                      "changeAmount": 5000
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Transaction not found" }
        },
        "security": [{ "Bearer": [] }]
      }
    }
  }
}
