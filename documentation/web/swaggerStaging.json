{
  "swagger": "2.0",
  "info": {
    "description": "Agilix POS Service API Documentation - Staging",
    "version": "1.0.0",
    "title": "Agilix POS Service API"
  },
  "host": "staging-pos-api.agilix.com",
  "basePath": "/api/v1",
  "schemes": ["https"],
  "tags": [
    { "name": "Auth", "description": "Authentication & authorization" },
    { "name": "Webhook", "description": "Console → POS webhook integration" },
    { "name": "Outlets", "description": "Outlet management" },
    { "name": "Products", "description": "Product & variant management" },
    { "name": "Inventory", "description": "Inventory & stock management" },
    { "name": "Orders", "description": "Order management" },
    { "name": "Payments", "description": "Payment processing" },
    { "name": "Transactions", "description": "Transaction history" },
    { "name": "Users", "description": "User management" },
    { "name": "Roles", "description": "Role & permission management" },
    { "name": "Categories", "description": "Product category management" },
    { "name": "Recipes", "description": "Recipe & composition management" },
    { "name": "Tables", "description": "Table & occupancy management" },
    { "name": "Printers", "description": "Printer configuration & bill printing" },
    { "name": "Settings", "description": "POS operational settings & configuration" },
    { "name": "Reports", "description": "Operational reporting" },
    { "name": "Audit Logs", "description": "System audit logs" }
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter token with format: Bearer {token}"
    },
    "ConsoleApiKey": {
      "type": "apiKey",
      "name": "x-api-key",
      "in": "header",
      "description": "Console API Key untuk webhook authentication"
    }
  }
}
