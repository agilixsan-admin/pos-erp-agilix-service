NODE_ENV=development
PORT=3000
CORS=*
# SWAGGER: development | staging | (empty = disabled)
SWAGGER=development

# Database Configuration (PostgreSQL / PgBouncer)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=aglix_pos
DB_DEFAULT_NAME=postgres
# Auto-create database if not exists (defaults to true in dev/staging, manual/false in production)
DB_AUTO_CREATE=true
DB_SSL=false
DB_LOGGING=false
# Database Connection Pool (PgBouncer compatible)
DB_POOL_MAX=20
DB_POOL_MIN=2
# statement_cache_size: set to 0 for PgBouncer transaction pooling mode
DB_STATEMENT_CACHE_SIZE=0
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Console Integration
CONSOLE_API_KEY=your-console-api-key-here

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Authentication (JWT)
JWT_SECRET=your-secure-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-secure-refresh-secret-min-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Storage (S3 / MinIO Object Storage)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=aglix-pos
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/aglix-pos

# Payment Gateway (QRIS)
QRIS_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Mail / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@agilix.id
SSL=false

# Frontend URL (For email invitation and password reset links)
FRONTEND_URL=http://localhost:3000
